diff --git a/IPlug/IPlugTimer.cpp b/IPlug/IPlugTimer.cpp
index eab7523d7..d40fcd617 100644
--- a/IPlug/IPlugTimer.cpp
+++ b/IPlug/IPlugTimer.cpp
@@ -15,6 +15,10 @@
 
 #include "IPlugTimer.h"
 
+#if defined OS_LINUX
+#include <chrono>
+#endif
+
 using namespace iplug;
 
 #if defined OS_MAC || defined OS_IOS
@@ -143,4 +147,42 @@ void Timer_impl::TimerProc(void* userData)
   Timer_impl* itimer = (Timer_impl*) userData;
   itimer->mTimerFunc(*itimer);
 }
+#elif defined OS_LINUX
+Timer* Timer::Create(ITimerFunction func, uint32_t intervalMs)
+{
+  return new Timer_impl(func, intervalMs);
+}
+
+Timer_impl::Timer_impl(ITimerFunction func, uint32_t intervalMs)
+: mTimerFunc(func)
+, mIntervalMs(intervalMs)
+, mRunning(true)
+{
+  mThread = std::thread([this]() {
+    while (mRunning.load(std::memory_order_acquire))
+    {
+      std::this_thread::sleep_for(std::chrono::milliseconds(mIntervalMs));
+      if (mRunning.load(std::memory_order_acquire))
+        mTimerFunc(*this);
+    }
+  });
+}
+
+Timer_impl::~Timer_impl()
+{
+  Stop();
+}
+
+void Timer_impl::Stop()
+{
+  mRunning.store(false, std::memory_order_release);
+  if (mThread.joinable())
+  {
+    // Stop() from the timer thread itself must not join itself.
+    if (std::this_thread::get_id() == mThread.get_id())
+      mThread.detach();
+    else
+      mThread.join();
+  }
+}
 #endif
